class Solution:
    def isBipartite(self, graph: List[List[int]]) -> bool:
        mapi = {i: graph[i] for i in range(len(graph))}
        lists = [0] * len(graph)
        def dfs(node):
            for nei in graph[node]:
                if lists[nei] == 0:
                    lists[nei] = 3 - lists[node]
                    if not dfs(nei):
                        return False
                elif lists[nei] == lists[node]:
                    return False 
            return True           
        for i in range(len(graph)):
            if lists[i] == 0:
                lists[i] = 1
                if not dfs(i):
                    return False
        return True            
        
          
                       
                
                            
        
        
