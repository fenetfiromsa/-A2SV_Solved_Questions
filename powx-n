class Solution:
    def myPow(self, x: float, n: int) -> float:
        def power(x, n):
            if x == 0:
                return 0
            if n == 0:
                return 1
            res = power(x, n//2)
            if n % 2 == 0:
                return res * res
            else:
                return res * res * x
        if n >= 0:
            return power(x, n)
        else:
            return 1/power(x, abs(n)) 

                        


        
