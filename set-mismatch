class Solution:
    def findErrorNums(self, nums: List[int]) -> List[int]:
        # counted = Counter(nums)
        # res = []
        # for val, fre in counted.items():
        #     if fre == 2:
        #         res.append(val)
        # num = set(nums)        
        # for i in range(1, len(nums) + 1):
        #     if i not in num:
        #         res.append(i)        

        # return res
        
        nums.sort()
        duplicate = -1
        missing = -1

        for i in range(1, len(nums)):
            if nums[i] == nums[i-1]:
                duplicate = nums[i]
            elif nums[i] > nums[i-1] + 1:
                missing = nums[i-1] + 1

        
        if nums[0] != 1:
            missing = 1
        elif nums[-1] != len(nums):
            missing = len(nums)

        return [duplicate, missing]       

