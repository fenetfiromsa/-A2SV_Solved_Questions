class Solution:
    def flipAndInvertImage(self, image: List[List[int]]) -> List[List[int]]:
        row=len(image)
        col=len(image[0])
        for num in image:
            num.reverse()
        for i in range(row):
            for j in range(col):
                if image[i][j]== 0:
                    image[i][j]=1
                elif image[i][j]==1:
                    image[i][j]=0
        return image                


        
