class Solution:
    def find132pattern(self, nums: List[int]) -> bool:
        cur_min = nums[0]
        stack = []
        for num in nums:
            while stack and num >= stack[-1][0]:
                stack.pop()
            if stack and stack[-1][1] < num:
                return True
            stack.append((num, cur_min))
            cur_min = min(num, cur_min)
        return False           


        
