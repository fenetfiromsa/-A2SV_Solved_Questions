class Solution:
    def findTheWinner(self, n: int, k: int) -> int:
        player = [i + 1 for i in range(n)]
        i = 0
        while len(player) > 1:
            ind = (i + k -1) % len(player)
            player.remove(player[ind])
            i = ind
        return player[0]    
        





        
       
        
