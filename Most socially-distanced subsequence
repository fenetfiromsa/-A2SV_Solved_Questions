t = int(input())
for _ in range(t):
    n = int(input())
    nums = list(map(int, input().split()))
    ans = [nums[0]]
    for i in range(1, n-1):
        if nums[i-1] < nums[i] and nums[i+1] < nums[i] or nums[i-1] > nums[i] and nums[i+1] > nums[i]:
            ans.append(nums[i])
    ans.append(nums[-1])
    print(len(ans))
    print(*ans)        

