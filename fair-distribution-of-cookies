class Solution:
    def distributeCookies(self, cookies: List[int], k: int) -> int:
        dist = [0] * k
        ans = float("inf")
        
        def backtrack(i):
            nonlocal ans
            
            if i == len(cookies):
                ans = min(ans, max(dist))
                return
            
            for j in range(k):
                dist[j] += cookies[i]
                
            
                if dist[j] < ans:
                    backtrack(i + 1)
                
                dist[j] -= cookies[i]
                

                if dist[j] == 0:
                    break
        
        backtrack(0)
        return ans

                
            
      
        
