class Solution:
    def sumEvenAfterQueries(self, nums: List[int], queries: List[List[int]]) -> List[int]:
        arr = []
        res = 0

        
        for i in nums:
            if i % 2 == 0:
                res += i

        for val, ind in queries:

            
            if nums[ind] % 2 == 0:
                res -= nums[ind]

            
            nums[ind] += val

            
            if nums[ind] % 2 == 0:
                res += nums[ind]

            arr.append(res)

        return arr
