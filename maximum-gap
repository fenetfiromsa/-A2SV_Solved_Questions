class Solution:
    def maximumGap(self, nums: List[int]) -> int:
        nums.sort()
        if len(nums) < 2:
            return 0
            exit()
        maxi = 0   
        for i in range(1, len(nums)):
            x = nums[i] - nums[i-1]
            maxi = max(maxi, x )
        return maxi    


        
