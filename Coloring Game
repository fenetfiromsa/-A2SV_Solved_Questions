import sys
input = sys.stdin.readline
from bisect import bisect_right
t = int(input())
for _ in range(t):
    n = int(input())
    nums = list(map(int, input().split()))
    M = nums[-1]
    ans = 0

    for k in range(2, n):
        for j in range(1, k):
            need1 = nums[k] - nums[j]
            need2 = M -  nums[j] -  nums[k]
            need = max(need1, need2)
            pos = bisect_right( nums, need, 0, j)
            ans += (j - pos)
    print(ans)
