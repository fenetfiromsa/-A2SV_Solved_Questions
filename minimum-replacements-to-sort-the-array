class Solution:
    def minimumReplacement(self, nums: List[int]) -> int:
        n = len(nums)
        count = 0
        r = nums[-1]
        for i in range(n-2, -1, -1):
            if nums[i] <= r:
                r = nums[i]
            else:
                s = (nums[i] + r-1) // r
                count += s-1
                r = nums[i]//s
                
        return count           

        
