        count = 0
        nums = []
        MOD = 10**9 + 7
        for inst in instructions:
            less = bisect_left(nums, inst)
            greater = len(nums) - bisect_right(nums, inst)
            count += min(less, greater)
            insort(nums, inst)
        return count % MOD  
