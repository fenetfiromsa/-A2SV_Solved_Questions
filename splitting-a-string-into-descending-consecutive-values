class Solution:
    def splitString(self, s: str) -> bool:
        def backtrack(ind, parts, pre):
            if ind == len(s):
                return parts >=2
            for i in range(ind, len(s)):
                num = int(s[ind : i + 1]) 
                if pre == -10000 or num == pre - 1:
                    if backtrack(i + 1, parts + 1, num):
                        return True
            return False
        return backtrack(0, 0, -10000)                  
 
        
        
