class NumMatrix:

    def __init__(self, matrix: List[List[int]]):
        n = len(matrix)
        m = len(matrix[0])
        self.pr = [[0 for i in range(m+1)] for j in range(n+1)]
        
        for i in range(n):
            for j in range(m):
                self.pr[i][j] = matrix[i][j] + self.pr[i-1][j] + self.pr[i][j-1] - self.pr[i-1][j-1] 

    def sumRegion(self, row1: int, col1: int, row2: int, col2: int) -> int:
        bx = self.pr[row2][col2]
        lbx = self.pr[row2][col1-1]
        ubx = self.pr[row1-1][col2]
        overlap =self.pr[row1-1][col1-1]
        return bx - lbx - ubx + overlap     
        


