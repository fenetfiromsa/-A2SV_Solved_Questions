class Solution:
    def maximumCandies(self, candies: List[int], k: int) -> int:
        
        def check(num):
            count = 0
            for candy in candies:
                count += candy // num
            return count >= k

        left, right = 1, max(candies)
        ans = 0

        while left <= right:
            mid = (left + right) // 2

            if check(mid):
                ans = mid
                left = mid + 1   
            else:
                right = mid - 1

        return ans
