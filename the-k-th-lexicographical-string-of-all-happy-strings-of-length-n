class Solution:
    def getHappyString(self, n: int, k: int) -> str:
        res = []
        def gene(a):
            if len(res) >= k:
                return
            if len(a) == n:
                res.append(a)
                return  
            for ch in ['a', 'b', 'c']:
                if not a or a[-1] != ch:
                    gene(a + ch)
        gene("") 
        return res[k-1] if k <= len(res) else ""                 




        
