class Solution:
    def removeInvalidParentheses(self, s: str) -> List[str]:
        left = 0
        right = 0
        for ch in s:
            if ch == "(":
                left += 1
            elif ch == ")":
                if left == 0:
                    right += 1
                else:
                    left -= 1
        res = set()                    
        def backtrack(i, path, count, left, right):
            if i == len(s):
                if left == 0 and right == 0 and count == 0:
                    res.add(path)
                return

            char = s[i]
            if char == "(" and left > 0:
                backtrack(i + 1, path, count, left - 1, right )
            elif char == ")" and right > 0:
                backtrack(i + 1, path, count, left, right - 1 )


            if char == "(" :
                backtrack(i + 1, path + char, count + 1, left , right )
            elif char == ")":
                if count > 0:
                    backtrack(i + 1, path + char, count - 1, left , right )
            else:
                backtrack(i + 1, path + char, count, left , right )
        backtrack(0, "", 0, left, right)
        return list(res)        












        







              

        

        


        
