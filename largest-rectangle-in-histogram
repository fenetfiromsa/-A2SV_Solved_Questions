class Solution:
    def largestRectangleArea(self, heights: List[int]) -> int:
        heights.append(0)
        area = 0
        stack = []
        maxarea = 0
        for i in range(len(heights)):
            while stack and heights[stack[-1]] > heights[i]:
                heigh =  heights[stack.pop()]
                if not stack:
                    w = i
                else:    
                    w = i - stack[-1] -1     
                area = heigh * w
                maxarea = max(area, maxarea)       
            stack.append(i)
        return maxarea

        
                 
        
        
