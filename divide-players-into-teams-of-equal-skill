class Solution:
    def dividePlayers(self, skill: List[int]) -> int:
        left = 0
        right = len(skill)-1
        res = []
        ans = 0
        skill.sort()
        while left < right:
            res.append([skill[left], skill[right]])
            left+=1
            right-=1
        sums = res[0][0] + res[0][1]    
        for i in range( len(res)):
            if res[i][0] + res[i][1] != sums:
                return -1
            else:
                ans+=  res[i][0] * res[i][1]
        return ans       



        

        
