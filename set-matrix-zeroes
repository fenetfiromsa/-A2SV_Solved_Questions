 class Solution:
    def setZeroes(self, matrix: List[List[int]]) -> None:
        row=len(matrix)
        col=len(matrix[0])
        zero_col, zero_row= set(), set()
        for i in range(row):
            for j in range(col):
                if matrix[i][j]==0:
                    zero_col.add(j)
                    zero_row.add(i)
        for i in range(row):
            for j in range(col):
                if j in zero_col:
                    matrix[i][j]=0
                if i in zero_row:
                    matrix[i][j]=0                


        

       
        
