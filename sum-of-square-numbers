class Solution:
    def judgeSquareSum(self, c: int) -> bool:
        left = 0
        right = int(c**0.5)
        while right >= left:
            if left*left + right*right == c:
                return True 
            elif left*left + right*right > c:
                right-=1
            else:
                left+=1    
        
        return False              
               
        
