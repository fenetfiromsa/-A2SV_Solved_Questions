class Solution:
    def pancakeSort(self, arr: List[int]) -> List[int]:
        res = []
        n = len(arr)
        for ind in range(n, 1, -1):
            max_index = arr.index(max(arr[:ind]))
            if max_index != ind - 1:
                if max_index != 0:
                    arr[:max_index + 1] = reversed(arr[:max_index + 1])
                    res.append(max_index + 1)
                arr[:ind] = reversed(arr[:ind])
                res.append(ind)
        return res            



        














