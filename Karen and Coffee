n, k, q = map(int, input().split())
recipes = []
for _ in range(n):
    start, end = map(int, input().split())
    recipes.append((start, end))

temp = [0]*200002
for start, end in recipes:
    temp[start]+=1
    temp[end+1]-=1 

for i in range(1,len(temp)):
    temp[i] += temp[i-1]

good = [0]*(200002)
for i in range(1, 200001):
    if temp[i] >= k:
        good[i] = 1


pref = [0]*(200002)
for i in range(1, 200001):
    pref[i] = pref[i-1] + good[i]


for _ in range(q):
    a, b = map(int, input().split())
    print(pref[b] - pref[a-1])
