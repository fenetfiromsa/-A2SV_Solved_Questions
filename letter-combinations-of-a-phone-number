class Solution:
    def letterCombinations(self, digits: str) -> List[str]:
        mydict = {
            '2': 'abc', '3': 'def', '4': 'ghi', '5': 'jkl',
            '6': 'mno', '7': 'pqrs', '8': 'tuv', '9': 'wxyz'
        }
        if not digits or digits == '1':
            return []
        comb = []
        res = []
        def pair(num):
           
            if len(comb) == len(digits):
                res.append("".join(comb))
                return
            for k in mydict[digits[num]]:
                comb.append(k)
                pair(num+1)
                comb.pop()
        pair(0)
        return res            

        
