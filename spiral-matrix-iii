class Solution:
    def spiralMatrixIII(self, rows, cols, rStart, cStart):
        result = []
        total = rows * cols
        
       
        directions = [(0,1), (1,0), (0,-1), (-1,0)]
        
        r, c = rStart, cStart
        result.append([r, c])
        
        step_length = 1
        
        while len(result) < total:
            for i in range(4):
                dr, dc = directions[i]
                
                for _ in range(step_length):
                    r += dr
                    c += dc
                    
                    if 0 <= r < rows and 0 <= c < cols:
                        result.append([r, c])
                
               
                if i % 2 == 1:
                    step_length += 1
                    
        return result
