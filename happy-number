                        
class Solution:
    def isHappy(self, n: int) -> bool:
        arr = []

        while True:
            x = 0
            n = str(n)

            for i in n:
                i = int(i)
                x += i * i

            if x == 1:
                return True

            if x in arr:
                return False

            arr.append(x)
            n = x
        
