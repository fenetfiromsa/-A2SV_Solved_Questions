class Solution:
    def findRestaurant(self, list1: List[str], list2: List[str]) -> List[str]:
        res = []
        min_sum = float('inf')

        for i in list1:
            if i in list2:
                ind = list1.index(i) + list2.index(i)

                if ind < min_sum:
                    min_sum = ind
                    res = [i]
                elif ind == min_sum:
                    res.append(i)

        return res


