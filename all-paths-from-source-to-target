class Solution:
    def allPathsSourceTarget(self, graph: List[List[int]]) -> List[List[int]]:
        mapi = {i: graph[i] for i in range(len(graph))}
        lists= []
        
        def dfs(node, path):
            
            path.append(node)
            if node == len(graph) - 1:
                lists.append(path[:])
            else:    
        
                for i in mapi[node]:
                    dfs(i, path)
            path.pop()        


        dfs(0, [])
        return lists


        
